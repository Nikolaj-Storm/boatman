flowchart LR

    subgraph ingest ["Prepare Knowledge"]
        direction TB
        SKP["10 Skill Packs\ndiesel · electrical · plumbing\nrigging · seamanship · safety\nfiberglass · diagnostics\nhydraulics · corrosion"]
        MAN["Manual Import\nPDF · TXT · MD"]
        WEB["Web Search\n(shore mode only)"]

        SKP --> chunk["Split into\nchunks by\nheadings"]
        MAN --> chunk
        WEB --> chunk

        chunk --> tag["Auto-tag\n12 categories\n60+ sub-tags"]
    end

    subgraph db ["Knowledge Base"]
        direction TB
        DB[("SQLite\ntagged chunks\nboat profiles\nchat history")]
    end

    tag ---> DB

    subgraph ask ["User Asks a Question"]
        direction TB
        Q(["Sailor types\na question"])
        PHOTO["or attaches\na photo"]
        Q ~~~ PHOTO
    end

    subgraph think ["Boatman Thinks"]
        direction TB
        ROUTE["Route query\nto categories\n& sub-tags"]
        SEARCH["Search\nmatching\nchunks"]
        BOAT{{"Boat Profile\nengine · electrical\nequipment · hull"}}
        BUILD["Assemble prompt\ninstructions + boat context\n+ best chunks + history\n+ question"]

        ROUTE --> SEARCH
        SEARCH --> BUILD
        BOAT --> BUILD
    end

    Q --> ROUTE
    PHOTO -.-> BUILD
    DB --> SEARCH

    subgraph answer ["Boatman Answers"]
        direction TB
        LLM{"LLM\nNobodyWho\non-device"}
        ANS["Step-by-step\nrepair guidance\nwith sources"]
    end

    BUILD --> LLM
    LLM --> ANS

    ANS -. "follow-up" .-> Q

    classDef source fill:#e8eaf6,stroke:#7986cb,stroke-width:1.5px,color:#283593
    classDef process fill:#fff3e0,stroke:#ffb74d,stroke-width:1.5px,color:#e65100
    classDef dbstyle fill:#f3e5f5,stroke:#ba68c8,stroke-width:2px,color:#6a1b9a
    classDef user fill:#e8f5e9,stroke:#81c784,stroke-width:2px,color:#2e7d32
    classDef llm fill:#fce4ec,stroke:#e57373,stroke-width:2px,color:#c62828
    classDef answerstyle fill:#e0f2f1,stroke:#4db6ac,stroke-width:1.5px,color:#00695c
    classDef boat fill:#fff9c4,stroke:#fdd835,stroke-width:2px,color:#f57f17

    class SKP,MAN,WEB source
    class chunk,tag,ROUTE,SEARCH,BUILD,PHOTO process
    class DB dbstyle
    class Q user
    class LLM llm
    class ANS answerstyle
    class BOAT boat
