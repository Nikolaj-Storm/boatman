%%{ init: { 'theme': 'base', 'themeVariables': { 'primaryColor': '#1e3a5f', 'primaryTextColor': '#fff', 'lineColor': '#64b5f6', 'fontSize': '16px', 'fontFamily': 'Segoe UI, Helvetica, Arial, sans-serif' } } }%%

graph LR
    User([" &#9875; Sailor "])

    subgraph UI [" &#9741; &ensp; Flutter UI "]
        direction TB
        Chat([" &#128172; Chat "])
        Boat([" &#9973; Boat Profile "])
        KB([" &#128218; Knowledge "])
        Settings([" &#9881; Settings "])
    end

    subgraph Services [" &#9881; &ensp; Core Engine "]
        direction TB
        AI([" &#129302; AI Service &ensp; RAG Pipeline "])
        Router([" &#128268; Query Router "])
        Photo([" &#128247; Photo Service "])
        Import([" &#128196; Manual Import "])
    end

    subgraph Storage [" &#128451; &ensp; On-Device Storage "]
        direction TB
        SQLite[(" &#128450; SQLite DB \n boats &middot; chats \n knowledge chunks ")]
        Files[(" &#128193; Local Files \n photos &middot; manuals ")]
    end

    subgraph Packs [" &#128214; &ensp; 10 Skill Packs "]
        direction TB
        P1([" Diesel &middot; Electrical "])
        P2([" Plumbing &middot; Rigging "])
        P3([" Safety &middot; Seamanship "])
        P4([" Fiberglass &middot; Diagnostics "])
        P5([" Hydraulics &middot; Corrosion "])
    end

    subgraph External [" &#127758; &ensp; Shore Mode "]
        direction TB
        Web([" &#128269; Web Search "])
        LLM([" &#129504; NobodyWho LLM \n planned "])
    end

    User -- " open app " --> UI
    UI -- " request " --> Services
    Services -- " read / write " --> Storage
    Services -- " retrieve " --> Packs
    Services -. " online only " .-> External

    %% Node styles
    classDef user fill:#0d253f,stroke:#1565c0,stroke-width:3px,color:#e3f2fd,font-size:16px,font-weight:bold
    classDef ui fill:#1565c0,stroke:#90caf9,stroke-width:2px,color:#e3f2fd,font-size:14px
    classDef svc fill:#00695c,stroke:#80cbc4,stroke-width:2px,color:#e0f2f1,font-size:14px
    classDef store fill:#4a148c,stroke:#ce93d8,stroke-width:2px,color:#f3e5f5,font-size:13px
    classDef pack fill:#0d47a1,stroke:#64b5f6,stroke-width:2px,color:#e3f2fd,font-size:13px
    classDef ext fill:#e65100,stroke:#ffb74d,stroke-width:2px,color:#fff3e0,font-size:13px

    class User user
    class Chat,Boat,KB,Settings ui
    class AI,Router,Photo,Import svc
    class SQLite,Files store
    class P1,P2,P3,P4,P5 pack
    class Web,LLM ext

    %% Link styles
    linkStyle 0 stroke:#90caf9,stroke-width:3px
    linkStyle 1 stroke:#80cbc4,stroke-width:3px
    linkStyle 2 stroke:#ce93d8,stroke-width:3px
    linkStyle 3 stroke:#64b5f6,stroke-width:3px
    linkStyle 4 stroke:#ffb74d,stroke-width:2px,stroke-dasharray:6
