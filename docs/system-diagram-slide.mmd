graph TB

    subgraph client [" Mobile App "]
        direction LR
        Flutter["<b>Flutter</b>\nCross-platform UI"]
        Provider["<b>Provider</b>\nState management"]
        Theme["<b>Boatman Theme</b>\nMaritime UX"]
    end

    Flutter --- Provider --- Theme

    subgraph screens [" Screens "]
        direction LR
        Chat["<b>Chat</b>\nAI assistant"]
        BoatProfile["<b>Boat Profile</b>\nVessel config"]
        Knowledge["<b>Knowledge Base</b>\nSkill packs"]
        Settings["<b>Settings</b>\nMode · theme"]
    end

    client -- "navigate" --> screens

    subgraph services [" Core Services "]
        direction LR
        AiService["<b>AI Service</b>\nRAG pipeline"]
        QueryRouter["<b>Query Router</b>\n12 categories"]
        PhotoService["<b>Photo Service</b>\nCapture · store"]
        ImportService["<b>Manual Import</b>\nPDF · TXT · MD"]
    end

    screens -- "user request" --> services

    AiService -. "classify query" .-> QueryRouter
    AiService -. "analyze photo" .-> PhotoService

    subgraph storage [" On-Device Storage "]
        direction LR
        SQLite["<b>SQLite</b>\nboats · chats · chunks"]
        LocalFiles["<b>Local Files</b>\nphotos · manuals"]
    end

    services -- "read / write" --> storage

    subgraph packs [" Skill Packs · 10 domains "]
        direction LR
        P1["<b>Diesel</b>\nEngines"]
        P2["<b>Electrical</b>\nSystems"]
        P3["<b>Plumbing</b>\nWater"]
        P4["<b>Rigging</b>\nSails · deck"]
        P5["<b>Seamanship</b>\nEmergency"]
    end

    subgraph packs2 [" "]
        direction LR
        P6["<b>Safety</b>\nTriage"]
        P7["<b>Diagnostics</b>\nField"]
        P8["<b>Fiberglass</b>\nHull repair"]
        P9["<b>Hydraulics</b>\nHoses"]
        P10["<b>Corrosion</b>\nFasteners"]
    end

    services -- "retrieve chunks" --> packs
    packs --- packs2

    subgraph external [" External · shore mode only "]
        direction LR
        WebSearch["<b>DuckDuckGo</b>\nManual search"]
        Downloads["<b>Web Downloads</b>\nPDF · HTML"]
        NobodyWho["<b>NobodyWho</b>\nOn-device LLM"]
    end

    services -. "online only" .-> external

    NobodyWhoNote["<i>not yet active · awaiting Flutter 3.41.6</i>"]
    NobodyWho -.- NobodyWhoNote

